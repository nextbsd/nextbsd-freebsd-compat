+/*
+ * The terminal on the serial port ConOut lists: the SimpleTextOut handle
+ * whose device path has a UART node, and its SimpleTextIn.  None found
+ * leaves the loader's text in the ring only, as before.
+ */
+static void
+boot_video_find_serial(void)
+{
+	EFI_DEVICE_PATH *dp;
+	EFI_HANDLE *hlist;
+	EFI_STATUS status;
+	UINTN i, n;
+	void *out, *in;
+
+	status = BS->LocateHandleBuffer(ByProtocol, &simple_text_out_guid,
+	    NULL, &n, &hlist);
+	if (EFI_ERROR(status))
+		return;
+	for (i = 0; i < n && bv_serial_out == NULL; i++) {
+		for (dp = efi_lookup_devpath(hlist[i]);
+		    dp != NULL && !IsDevicePathEnd(dp);
+		    dp = NextDevicePathNode(dp)) {
+			if (DevicePathType(dp) != MESSAGING_DEVICE_PATH ||
+			    DevicePathSubType(dp) != MSG_UART_DP)
+				continue;
+			if (OpenProtocolByHandle(hlist[i],
+			    &simple_text_out_guid, &out) != EFI_SUCCESS ||
+			    OpenProtocolByHandle(hlist[i],
+			    &simple_text_in_guid, &in) != EFI_SUCCESS)
+				break;
+			bv_serial_out = out;
+			bv_serial_in = in;
+			break;
+		}
+	}
+	BS->FreePool(hlist);
+}
+
+/* A serial port mirrors the graphics boot: keep the autoboot countdown. */
+bool
+efi_boot_video_serial(void)
+{
+	return (boot_v_display == GRAPHICS_MODE && bv_serial_in != NULL);
+}
