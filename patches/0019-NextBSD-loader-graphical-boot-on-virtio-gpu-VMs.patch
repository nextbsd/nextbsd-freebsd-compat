@@ -1489,6 +1496,19 @@ main(int argc, CHAR16 *argv[])
 		}
 	}
 
+	/*
+	 * NextBSD: a graphics boot with a serial port behind the screen
+	 * stays graphical in the kernel too.  The serial half of
+	 * RB_MULTIPLE came from ConOut, not from the boot flags, so it is
+	 * not exported: boot_multicons would turn the kernel's splash off.
+	 * Asking for serial (loader.conf, -D, or typing at the prompt)
+	 * still leaves graphics mode and keeps it.
+	 */
+	if (efi_boot_video_display() == GRAPHICS_MODE &&
+	    (howto & RB_MULTIPLE) != 0 && (uhowto & RB_MULTIPLE) != 0 &&
+	    (boot_video_args(argc, argv) & RB_MULTIPLE) == 0)
+		howto &= ~RB_MULTIPLE;
+
 	/*
 	 * howto is set now how we want to export the flags to the kernel, so
 	 * set the env based on it.
