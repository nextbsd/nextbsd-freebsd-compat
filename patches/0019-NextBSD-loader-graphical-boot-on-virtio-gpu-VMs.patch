 int
 efi_find_framebuffer(teken_gfx_t *gfx_state)
 {
 	EFI_PHYSICAL_ADDRESS ptr;
-	EFI_HANDLE *hlist;
+	EFI_HANDLE *hlist, blt_handle;
+	EFI_GRAPHICS_OUTPUT *blt_gop = NULL;
 	UINTN nhandles, i, hsize;
 	struct efi_fb efifb;
 	EFI_STATUS status;
@@ -616,8 +716,16 @@ efi_find_framebuffer(teken_gfx_t *gfx_state)
 
 		/*
 		 * Search for ConOut protocol, if not found, use first handle.
+		 *
+		 * NextBSD: a blit-only GOP (virtio-gpu, under OVMF and
+		 * AAVMF alike) is used when no GOP has a linear framebuffer.
+		 * gfx_fb draws everything through gop->Blt() while boot
+		 * services run, and the kernel gets no EFI framebuffer
+		 * record (fb_addr is 0); its own virtio_gpu(4) takes the
+		 * display over from the splash.
 		 */
 		gop_handle = NULL;
+		blt_handle = NULL;
 		for (i = 0; i < nhandles; i++) {
 			EFI_GRAPHICS_OUTPUT *tgop;
 			void *dummy;
@@ -627,8 +735,14 @@ efi_find_framebuffer(teken_gfx_t *gfx_state)
 			if (status != EFI_SUCCESS)
 				continue;
 
-			if (tgop->Mode->Info->PixelFormat == PixelBltOnly ||
-			    tgop->Mode->Info->PixelFormat >= PixelFormatMax)
+			if (tgop->Mode->Info->PixelFormat == PixelBltOnly) {
+				if (blt_handle == NULL) {
+					blt_handle = hlist[i];
+					blt_gop = tgop;
+				}
+				continue;
+			}
+			if (tgop->Mode->Info->PixelFormat >= PixelFormatMax)
 				continue;
 
 			status = OpenProtocolByHandle(hlist[i], &conout_guid,
@@ -644,6 +758,10 @@ efi_find_framebuffer(teken_gfx_t *gfx_state)
 		}
 
 		free(hlist);
+		if (gop_handle == NULL && blt_handle != NULL) {
+			gop_handle = blt_handle;
+			gop = blt_gop;
+		}
 		if (gop_handle == NULL)
 			return (ENXIO);
 
