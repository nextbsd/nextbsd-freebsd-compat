+/*
+ * NextBSD: start the firmware's drivers for the PCI display controllers when
+ * nothing produced a GOP.  OVMF connects only the devices its boot needs
+ * (ConOut and the boot disk), so a VM whose only display is virtio-gpu-pci
+ * (-vga none) reaches the loader with VirtioGpuDxe never started and no GOP
+ * at all, although the driver is there (the UEFI shell's full connect shows
+ * it).  Connecting display controllers only (PCI base class 0x03) keeps
+ * the rest of the machine as the firmware left it.
+ */
+/*
+ * NextBSD: put the GOP the loader had to connect first in ConOut, once, so
+ * the firmware lights that display itself on later boots: without it OVMF
+ * shows nothing on a virtio-gpu-only VM until the loader runs ("Display
+ * output is not active").  First, so the screen stays the primary console
+ * and a serial port in ConOut stays behind it (RB_MULTIPLE alone).  Written
+ * only when the device path is not there yet.
+ */
+static void
+efi_conout_add_gop(void)
+{
+	EFI_GUID global_var_guid = EFI_GLOBAL_VARIABLE;
+	EFI_DEVICE_PATH *dp, *end;
+	EFI_HANDLE *hlist;
+	EFI_STATUS status;
+	UINTN nhandles;
+	size_t glen, olen, i;
+	static char old[4096], buf[4096 * 2];
+
+	status = BS->LocateHandleBuffer(ByProtocol, &gop_guid, NULL,
+	    &nhandles, &hlist);
+	if (EFI_ERROR(status))
+		return;
+	/* The display's own GOP, not the console splitter's (no path). */
+	dp = NULL;
+	for (i = 0; i < nhandles && dp == NULL; i++)
+		dp = efi_lookup_devpath(hlist[i]);
+	BS->FreePool(hlist);
+	if (dp == NULL)
+		return;
+	glen = efi_devpath_length(dp);
+	if (glen <= 4 || glen > sizeof(old))
+		return;
+	olen = sizeof(old);
+	if (efi_global_getenv("ConOut", old, &olen) != EFI_SUCCESS)
+		olen = 0;
+	/* Already listed: compare without the 4-byte end node. */
+	for (i = 0; olen >= glen - 4 && i <= olen - (glen - 4); i++)
+		if (memcmp(old + i, dp, glen - 4) == 0)
+			return;
+	memcpy(buf, dp, glen);
+	if (olen > 0) {
+		/* End this instance; the old list follows. */
+		end = (EFI_DEVICE_PATH *)(buf + glen - 4);
+		end->SubType = END_INSTANCE_DEVICE_PATH_SUBTYPE;
+		memcpy(buf + glen, old, olen);
+	}
+	(void)efi_setenv(&global_var_guid, "ConOut",
+	    EFI_VARIABLE_NON_VOLATILE | EFI_VARIABLE_BOOTSERVICE_ACCESS |
+	    EFI_VARIABLE_RUNTIME_ACCESS, buf, glen + olen);
+}
+
+void
+efi_connect_display_controllers(void)
+{
+	EFI_PCI_IO_PROTOCOL *pciio;
+	EFI_HANDLE *hlist;
+	EFI_STATUS status;
+	UINTN i, nhandles;
+	UINT8 class[3];
+	bool connected;
+
+	if (efi_has_gop())
+		return;
+	connected = false;
+	status = BS->LocateHandleBuffer(ByProtocol, &pciio_guid, NULL,
+	    &nhandles, &hlist);
+	if (EFI_ERROR(status))
+		return;
+	for (i = 0; i < nhandles; i++) {
+		status = OpenProtocolByHandle(hlist[i], &pciio_guid,
+		    (void **)&pciio);
+		if (EFI_ERROR(status))
+			continue;
+		/* Programming interface, subclass, base class at 0x09. */
+		status = pciio->Pci.Read(pciio, EfiPciIoWidthUint8, 0x09, 3,
+		    class);
+		if (EFI_ERROR(status) || class[2] != 0x03)
+			continue;
+		(void)BS->ConnectController(hlist[i], NULL, NULL, TRUE);
+		connected = true;
+	}
+	BS->FreePool(hlist);
+	if (connected && efi_has_gop())
+		efi_conout_add_gop();
+}
