diff --git a/stand/efi/loader/main.c b/stand/efi/loader/main.c
index 0d153500c..8a295706d 100644
--- a/stand/efi/loader/main.c
+++ b/stand/efi/loader/main.c
@@ -753,30 +753,77 @@ boot_video_args(int argc, CHAR16 *argv[])
 static int boot_hotkey_howto;
 static bool boot_hotkey_esc;
 
+static void
+boot_hotkey_key(const EFI_INPUT_KEY *key)
+{
+	if (key->ScanCode == SCAN_ESC)
+		boot_hotkey_esc = true;
+	switch (key->UnicodeChar) {
+	case 'v': case 'V':
+		boot_hotkey_howto |= RB_VERBOSE;
+		break;
+	case 's': case 'S':
+		boot_hotkey_howto |= RB_SINGLE;
+		break;
+	}
+}
+
+/*
+ * Option (Alt on a PC keyboard) opens the Startup Manager (stand/lua/
+ * startup.lua).  Option is a modifier on its own: plain ReadKeyStroke()
+ * never reports it, so the keys are read through the extended input
+ * protocol, with EFI_KEY_STATE_EXPOSED asking the firmware for partial
+ * keystrokes too (a modifier with no key).  Firmware without the
+ * protocol, or that ignores the toggle, never reports Option; there the
+ * Startup Manager is reached from the prompt, boot -r.  The loader tells
+ * Lua through nextbsd_startup_manager=option.
+ */
+static EFI_GUID boot_hotkey_ex_guid = EFI_SIMPLE_TEXT_INPUT_EX_PROTOCOL_GUID;
+
 static void
 boot_hotkeys_read(void)
 {
+	EFI_SIMPLE_TEXT_INPUT_EX_PROTOCOL *ex = NULL;
+	EFI_KEY_TOGGLE_STATE toggles;
+	EFI_KEY_DATA kd;
 	EFI_INPUT_KEY key;
+	bool option = false;
 	int ms;
 
+	if (BS->HandleProtocol(ST->ConsoleInHandle, &boot_hotkey_ex_guid,
+	    (void **)&ex) != EFI_SUCCESS)
+		ex = NULL;
+	if (ex != NULL) {
+		toggles = EFI_TOGGLE_STATE_VALID | EFI_KEY_STATE_EXPOSED;
+		(void)ex->SetState(ex, &toggles);
+	}
 	for (ms = 0; ms < BOOT_HOTKEY_POLL_MS; ms += BOOT_HOTKEY_STEP_MS) {
-		while (ST->ConIn->ReadKeyStroke(ST->ConIn, &key) ==
-		    EFI_SUCCESS) {
-			if (key.ScanCode == SCAN_ESC)
-				boot_hotkey_esc = true;
-			switch (key.UnicodeChar) {
-			case 'v': case 'V':
-				boot_hotkey_howto |= RB_VERBOSE;
-				break;
-			case 's': case 'S':
-				boot_hotkey_howto |= RB_SINGLE;
-				break;
+		if (ex != NULL) {
+			while (ex->ReadKeyStrokeEx(ex, &kd) == EFI_SUCCESS) {
+				if ((kd.KeyState.KeyShiftState &
+				    EFI_SHIFT_STATE_VALID) != 0 &&
+				    (kd.KeyState.KeyShiftState &
+				    (EFI_LEFT_ALT_PRESSED |
+				    EFI_RIGHT_ALT_PRESSED)) != 0)
+					option = true;
+				boot_hotkey_key(&kd.Key);
 			}
+		} else {
+			while (ST->ConIn->ReadKeyStroke(ST->ConIn, &key) ==
+			    EFI_SUCCESS)
+				boot_hotkey_key(&key);
 		}
-		if (boot_hotkey_howto != 0 || boot_hotkey_esc)
-			return;
+		if (boot_hotkey_howto != 0 || boot_hotkey_esc || option)
+			break;
 		BS->Stall(BOOT_HOTKEY_STEP_MS * 1000);
 	}
+	if (ex != NULL) {
+		toggles = EFI_TOGGLE_STATE_VALID;
+		(void)ex->SetState(ex, &toggles);
+	}
+	/* Option with V or S held too: those win, as on a Mac. */
+	if (option && boot_hotkey_howto == 0 && !boot_hotkey_esc)
+		setenv("nextbsd_startup_manager", "option", 1);
 }
 
 /* The boot flags the startup keys asked for (RB_VERBOSE, RB_SINGLE). */
