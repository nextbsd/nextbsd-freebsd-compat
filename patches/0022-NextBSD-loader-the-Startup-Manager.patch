+-- NextBSD: the Startup Manager (startup.lua), over the splash.  Option
+-- held (loader.efi sets nextbsd_startup_manager=option) opens it to stay;
+-- otherwise, with more than one version installed, it shows for
+-- nextbsd_startup_delay seconds (3; 0 or NO for the logo alone) and starts
+-- the usual version unless a key is pressed.  A choice boots from there;
+-- Esc comes back here and stops at the prompt.  An error in it never stops
+-- the boot: it is printed, and the usual version starts.
+local function nbStartupDelay()
+	local d = loader.getenv("nextbsd_startup_delay")
+	if d == nil then
+		return 3
+	end
+	if d == "NO" or d == "no" then
+		return 0
+	end
+	return tonumber(d) or 3
+end
+
+if core.isUEFIBoot() and gfx ~= nil and gfx.fb_text ~= nil and
+    loader.perform("boot-video is-graphics") == 0 then
+	local option = loader.getenv("nextbsd_startup_manager") == "option"
+	local delay = nbStartupDelay()
+	local ok, prompt = pcall(function()
+		local startup = require("startup")
+		if option then
+			return startup.run()
+		elseif delay > 0 and startup.worthShowing() then
+			return startup.run(delay)
+		end
+		return false
+	end)
+	if not ok then
+		print("Startup Manager: " .. tostring(prompt))
+	elseif prompt then
+		loader.setenv("autoboot_delay", "NO")
+	end
+end
 -- Our console may have been setup with different settings before we get
 -- here, so make sure we reset everything back to default.
 if color.isEnabled() then
diff --git a/stand/lua/startup.lua b/stand/lua/startup.lua
new file mode 100644
index 000000000..92b8f737f
--- /dev/null
+++ b/stand/lua/startup.lua
@@ -0,0 +1,345 @@
+--
+-- SPDX-License-Identifier: BSD-2-Clause
+--
+-- NextBSD: the Startup Manager (nextbsd/nextbsd-freebsd-compat#95).
+--
+-- Every graphical start with more than one version shows it for a few
+-- seconds, counting down as the loader's prompt does (nextbsd_startup_delay,
+-- 3 unless loader.conf says otherwise; 0 turns it off), and any key stops
+-- the count.  Holding Option (Alt on a PC keyboard) while the computer
+-- starts, or boot -r at the loader prompt, opens it with no count: every
+-- installed version of NextBSD (each
+-- a ZFS boot environment, named after its build) as a disk on the boot
+-- screen's grey.  Left and right choose, Return starts the chosen one
+-- this once (nothing on disk changes, so the next restart starts the
+-- usual one again), V and S add a verbose or single-user start, and Esc
+-- opens the loader prompt.  To change which version starts every time,
+-- use Installed Versions in Update.
+--
+-- Drawn with the loader's framebuffer: gfx.fb_fill_rgb for the grey,
+-- PNGs from /boot/images blended with gfx.fb_putimage, and the names in
+-- the console font with gfx.fb_text, which leaves the grey behind them.
+--
+
+local config = require("config")
+local core = require("core")
+
+local startup = {}
+
+-- The boot screen's own colour (bootsplash_style, from gfx.boot_splash):
+-- black for NextBSD's, grey for Gershwin's.  The tile and button images
+-- have a version for each, chosen by how light the colour is.
+local BG = 0x000000
+local DARK = true
+local NAME = 0xe8e8ec
+local HINT = 0xe3e6ea
+local ON = 0x00d4ff
+local OFF = 0xc8ccd2
+
+local IMAGES = "/boot/images/"
+
+-- The loader's Lua has no math or table library (interp_lua.c).
+local function max(a, b)
+	return a > b and a or b
+end
+
+local function min(a, b)
+	return a < b and a or b
+end
+
+local function rgb(c)
+	return (c >> 16) & 0xff, (c >> 8) & 0xff, c & 0xff
+end
+
+local function image(name, scale)
+	if scale == 2 then
+		return IMAGES .. name .. "@2x.png"
+	end
+	return IMAGES .. name .. ".png"
+end
+
+-- The installed versions, the one the pool starts first.
+local function versions()
+	local list = {}
+	local rest = {}
+	local default = core.bootenvDefault()
+
+	for _, be in ipairs(core.bootenvList()) do
+		local v = {
+			be = be,
+			name = be:match("/ROOT/(.+)$") or be,
+		}
+		if be == default then
+			list[1] = v
+		else
+			rest[#rest + 1] = v
+		end
+	end
+	for _, v in ipairs(rest) do
+		list[#list + 1] = v
+	end
+	return list
+end
+
+-- The usual boot splash, for the moment between a choice and the
+-- kernel's first paint, as loader.lua paints it.
+local function splash()
+	local s = gfx.boot_splash()
+
+	if s == nil then
+		return
+	end
+	gfx.fb_fill_rgb(rgb(s.bg))
+	if s.logo ~= nil then
+		gfx.fb_putimage(s.logo, s.logo_x, s.logo_y,
+		    s.logo_x + s.logo_w, s.logo_y + s.logo_h, 2)
+	end
+end
+
+local function text(str, x, y, color)
+	local r, g, b = rgb(color)
+
+	return gfx.fb_text(str, x, y, r, g, b)
+end
+
+local function centred(str, cx, y, color, fw)
+	text(str, cx - (#str * fw) // 2, y, color)
+end
+
+-- One screen: the disks in a row, the chosen one on a darker tile, the
+-- start button under them, the V and S options and the hints.
+local function draw(list, sel, flags, geo)
+	local s, fw, fh, w = geo.scale, geo.fw, geo.fh, geo.w
+	local tw, th, gap = 180 * s, 160 * s, 24 * s
+	local d = 96 * s
+	-- As many as fit, the chosen one among them.
+	local fit = max(1, (w - 40 * s + gap) // (tw + gap))
+	local first = 1
+
+	if #list > fit then
+		first = max(1, min(sel - fit // 2, #list - fit + 1))
+	end
+	local last = min(#list, first + fit - 1)
+	local n = last - first + 1
+	local x0 = (w - (n * tw + (n - 1) * gap)) // 2
+	local y0 = geo.h * 30 // 100
+
+	gfx.fb_fill_rgb(rgb(BG))
+	for i = first, last do
+		local x = x0 + (i - first) * (tw + gap)
+		local name = list[i].name
+		local room = (tw - 8 * s) // fw
+
+		if i == sel then
+			gfx.fb_putimage(image(DARK and "nextbsd-startup-sel-dark" or
+			    "nextbsd-startup-sel", s),
+			    x, y0, x + tw, y0 + th, 2)
+		end
+		gfx.fb_putimage(image("nextbsd-startup-disk", s),
+		    x + (tw - d) // 2, y0 + 10 * s,
+		    x + (tw - d) // 2 + d, y0 + 10 * s + d, 2)
+		if #name > room then
+			name = name:sub(1, room - 1) .. "~"
+		end
+		centred(name, x + tw // 2, y0 + 10 * s + d + 10 * s, NAME, fw)
+	end
+
+	local g = 36 * s
+	local gy = y0 + th + 28 * s
+	gfx.fb_putimage(image(DARK and "nextbsd-startup-go-dark" or
+	    "nextbsd-startup-go", s),
+	    w // 2 - g // 2, gy, w // 2 - g // 2 + g, gy + g, 2)
+
+	local oy = gy + g + 18 * s
+	local v, sg = "V Verbose", "S Single-user"
+	local ow = (#v + 4 + #sg) * fw
+	local ox = w // 2 - ow // 2
+	text(v, ox, oy, flags.v and ON or OFF)
+	text(sg, ox + (#v + 4) * fw, oy, flags.s and ON or OFF)
+
+	geo.count_y = oy + fh * 2
+	local hy = geo.count_y + fh * 2
+	centred("Left and right choose.  Return starts it this once.",
+	    w // 2, hy, HINT, fw)
+	centred("V and S add options.  Esc opens the loader prompt.",
+	    w // 2, hy + fh + 4 * s, HINT, fw)
+	centred("To change which version starts every time, use " ..
+	    "Installed Versions in Update.", w // 2, hy + 2 * (fh + 4 * s),
+	    HINT, fw)
+end
+
+-- The countdown line, redrawn on its own each second.
+local function count(geo, name, secs)
+	local r, g, b = rgb(BG)
+
+	gfx.fb_fill_rgb(r, g, b, 0, geo.count_y, geo.w, geo.count_y + geo.fh)
+	if secs ~= nil then
+		centred("Starting " .. name .. " in " .. secs ..
+		    (secs == 1 and " second" or " seconds") ..
+		    ".  Press any key to choose.", geo.w // 2, geo.count_y,
+		    NAME, geo.fw)
+	end
+end
+
+-- Start a version once: point the loader at it (as bootenv does) and
+-- boot, with -v or -s when chosen.
+local function start(list, sel, flags)
+	local v = list[sel]
+	local args = ""
+
+	if sel ~= 1 then
+		loader.setenv("vfs.root.mountfrom", v.be)
+		loader.setenv("currdev", v.be .. ":")
+		config.reload()
+		if loader.getenv("kernelname") ~= nil then
+			loader.perform("unload")
+		end
+	end
+	if flags.v then
+		args = args .. " -v"
+	end
+	if flags.s then
+		args = args .. " -s"
+	end
+	if args ~= "" then
+		-- Verbose and single-user starts are text, as with Command-V
+		-- and Command-S held.
+		loader.perform("boot-video text")
+	else
+		splash()
+	end
+	core.boot(args)
+end
+
+-- A key: "left", "right", "return", "esc", or the character.
+local function key()
+	if not io.ischar() then
+		return nil
+	end
+	local ch = io.getchar()
+
+	if ch == 27 then
+		-- An arrow arrives as ESC [ C; Esc alone is just ESC.
+		for _ = 1, 30 do
+			if io.ischar() then
+				break
+			end
+			loader.delay(1000)
+		end
+		if not io.ischar() then
+			return "esc"
+		end
+		local c2 = io.getchar()
+		if c2 == 91 or c2 == 79 then
+			local c3 = io.getchar()
+			if c3 == 67 then
+				return "right"
+			elseif c3 == 68 then
+				return "left"
+			end
+		end
+		return nil
+	end
+	if ch == 13 or ch == 10 then
+		return "return"
+	end
+	if ch > 0 and ch < 256 then
+		return string.char(ch):lower()
+	end
+	return "other"
+end
+
+-- Whether the Startup Manager can draw here: a framebuffer, and this
+-- loader's gfx.fb_text.
+function startup.available()
+	return gfx ~= nil and gfx.fb_text ~= nil and gfx.fb_font ~= nil and
+	    gfx.fb_font() ~= nil
+end
+
+-- Whether there is more than one version to choose from.
+function startup.worthShowing()
+	return #versions() > 1
+end
+
+-- Show the Startup Manager.  With secs, it counts down and starts the
+-- usual version at zero unless a key is pressed first.  Returns only when
+-- Esc asks for the prompt (or there is nothing to choose); a choice boots.
+function startup.run(secs)
+	if not startup.available() then
+		return false
+	end
+	local list = versions()
+	if #list == 0 then
+		return false
+	end
+	-- Graphics mode ignores the keyboard otherwise (efi_console.c).
+	loader.perform("boot-video keyboard")
+	local fw, fh, w, h = gfx.fb_font()
+	local splash_info = gfx.boot_splash()
+	local geo = {
+		fw = fw, fh = fh, w = w, h = h,
+		scale = (splash_info ~= nil and splash_info.scale == 2) and 2 or 1,
+	}
+	if splash_info ~= nil then
+		BG = splash_info.bg
+		local r, g, b = rgb(BG)
+		DARK = r + g + b < 3 * 0x40
+	end
+	local sel, flags = 1, { v = false, s = false }
+	local dirty = true
+	local left = secs
+	local ticks = 0
+
+	while true do
+		if dirty then
+			draw(list, sel, flags, geo)
+			count(geo, list[sel].name, left)
+			dirty = false
+		end
+		local k = key()
+		if k == nil then
+			loader.delay(20000)
+			if left ~= nil then
+				ticks = ticks + 1
+				if ticks >= 50 then
+					ticks = 0
+					left = left - 1
+					if left <= 0 then
+						start(list, sel, flags)
+						loader.perform("boot-video text")
+						return true
+					end
+					count(geo, list[sel].name, left)
+				end
+			end
+		else
+			if left ~= nil then
+				left = nil
+				dirty = true
+			end
+			if k == "left" then
+				sel = sel > 1 and sel - 1 or #list
+				dirty = true
+			elseif k == "right" then
+				sel = sel < #list and sel + 1 or 1
+				dirty = true
+			elseif k == "return" then
+				start(list, sel, flags)
+				-- The boot failed: back to the prompt with its message.
+				loader.perform("boot-video text")
+				return true
+			elseif k == "v" then
+				flags.v = not flags.v
+				dirty = true
+			elseif k == "s" then
+				flags.s = not flags.s
+				dirty = true
+			elseif k == "esc" then
+				loader.perform("boot-video text")
+				return true
+			end
+		end
+	end
+end
+
+return startup
