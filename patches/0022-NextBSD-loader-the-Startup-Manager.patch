diff --git a/stand/liblua/gfx_utils.c b/stand/liblua/gfx_utils.c
index 1ea6d339e..5236c3c3e 100644
--- a/stand/liblua/gfx_utils.c
+++ b/stand/liblua/gfx_utils.c
@@ -329,6 +329,51 @@ lua_boot_splash(lua_State *L)
 	return 1;
 }
 
+/*
+ * gfx.fb_text(text, x, y, r, g, b)
+ * NextBSD: text in the console font in an exact colour, with nothing
+ * behind it (gfx_fb_text); returns the width drawn in pixels.
+ */
+static int
+lua_fb_text(lua_State *L)
+{
+	const char *s;
+	uint32_t x, y, r, g, b;
+
+	if (lua_gettop(L) != 6) {
+		lua_pushinteger(L, 0);
+		return 1;
+	}
+	s = luaL_checkstring(L, 1);
+	x = luaL_checknumber(L, 2);
+	y = luaL_checknumber(L, 3);
+	r = luaL_checkinteger(L, 4) & 0xff;
+	g = luaL_checkinteger(L, 5) & 0xff;
+	b = luaL_checkinteger(L, 6) & 0xff;
+	lua_pushinteger(L, gfx_fb_text(s, x, y, (r << 16) | (g << 8) | b));
+	return 1;
+}
+
+/*
+ * gfx.fb_font()
+ * NextBSD: the console font's cell and the framebuffer's size, for
+ * laying out gfx.fb_text(): fw, fh, width, height; nil without a
+ * framebuffer.
+ */
+static int
+lua_fb_font(lua_State *L)
+{
+	if (gfx_state.tg_fb_type == FB_TEXT) {
+		lua_pushnil(L);
+		return 1;
+	}
+	lua_pushinteger(L, gfx_state.tg_font.vf_width);
+	lua_pushinteger(L, gfx_state.tg_font.vf_height);
+	lua_pushinteger(L, gfx_state.tg_fb.fb_width);
+	lua_pushinteger(L, gfx_state.tg_fb.fb_height);
+	return 4;
+}
+
 /*
