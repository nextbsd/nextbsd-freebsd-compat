From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pkgdemon <jpm820@gmail.com>
Date: Sat, 7 Nov 2026 12:58:15 -0600
Subject: [PATCH] NextBSD: loader boot-video mode, graphics or text decided
 once

loader.efi takes on boot.efi's role for NextBSD's graphical boot
(nextbsd/nextbsd#542, E19 audit 1 D1-D2). It decides xnu's Boot_Video
v_display once, in main() before the console is probed:

- GRAPHICS_MODE (1) when ConOut lists no serial port
  (parse_uefi_con_out() == 0), the load options carry none of -v, -s,
  -a, -h, -D, and cons_update_mode() finds a GOP framebuffer.
- FB_TEXT_MODE (2) otherwise. That is the stock loader, unchanged.

In GRAPHICS_MODE no loader text reaches the screen. efi_cons_putchar()
keeps every byte in a 16 KB replay ring, and cons_update_mode() and the
teken colour hook draw no frame, erase or cursor, so the screen belongs
to the boot splash. comconsole output does not pass through the EFI
console and is never kept.

Leaving GRAPHICS_MODE (efi_boot_video_text()) draws the text console as
cons_update_mode() does and replays the ring. It runs:

- when the final boot flags have verbose, single-user, askname or a
  serial console;
- from loader.lua, after loader.conf is read, when boot_verbose,
  boot_single, boot_askname, boot_serial or boot_multicons is set,
  console names comconsole, the beastie menu is enabled, or a password
  or GELI passphrase prompt is configured;
- on every error path: interact() reaching the prompt (no kernel found,
  a failed boot, autoboot_delay=NO), interactive_interrupt() and a
  loader panic (an EFI panic_action()).

No key ever leaves GRAPHICS_MODE (maintainer decision, as on Darwin), so
autoboot does not poll keys and boots at once in that mode. A "boot-video"
command reports the mode (status, is-graphics) and drops to text (text).

CI's OVMF/AAVMF list the UART in ConOut, so CI never enters
GRAPHICS_MODE and its serial byte stream is unchanged. BIOS loaders are
untouched.

Carried out-of-tree for NextBSD.
---
 stand/common/boot.c            |  10 +++
 stand/common/bootstrap.h       |  10 +++
 stand/common/interp.c          |   8 ++
 stand/efi/libefi/efi_console.c | 139 +++++++++++++++++++++++++++++++++
 stand/efi/loader/main.c        |  62 +++++++++++++++
 stand/lua/loader.lua           |  26 ++++++
 6 files changed, 255 insertions(+)

diff --git a/stand/common/boot.c b/stand/common/boot.c
index e0775c0..b186c3f 100644
--- a/stand/common/boot.c
+++ b/stand/common/boot.c
@@ -191,6 +191,16 @@ autoboot(int timeout, char *prompt)
 		}
 	}
 
+#ifdef EFI
+	/*
+	 * NextBSD boot-video graphics mode: no key interrupts a normal boot
+	 * (as on Darwin) and nothing is on screen to wait for, so boot now.
+	 * -v, -s and serial consoles are text mode and keep the countdown.
+	 */
+	if (efi_boot_video_display() == GRAPHICS_MODE)
+		timeout = -1;
+#endif
+
 	kernelname = getenv("kernelname");
 	if (kernelname == NULL) {
 		argv[0] = NULL;
diff --git a/stand/common/bootstrap.h b/stand/common/bootstrap.h
index 7be1d68..2c6572d 100644
--- a/stand/common/bootstrap.h
+++ b/stand/common/bootstrap.h
@@ -124,6 +124,16 @@ void cons_probe(void);
 bool		cons_update_mode(bool);
 void		autoload_font(bool);
 
+/*
+ * NextBSD boot-video mode (EFI loader only): the booter's half of xnu's
+ * Boot_Video v_display.  GRAPHICS_MODE and FB_TEXT_MODE carry xnu's values.
+ */
+#define	GRAPHICS_MODE	1
+#define	FB_TEXT_MODE	2
+void		efi_boot_video_graphics(void);
+void		efi_boot_video_text(void);
+int		efi_boot_video_display(void);
+
 extern int module_verbose;
 enum {
 	MODULE_VERBOSE_SILENT,		/* say nothing */
diff --git a/stand/common/interp.c b/stand/common/interp.c
index e1fa4f9..77e6b3b 100644
--- a/stand/common/interp.c
+++ b/stand/common/interp.c
@@ -70,6 +70,14 @@ interact(void)
 	 */
 	autoboot_maybe();
 
+#ifdef EFI
+	/*
+	 * Not booting: NextBSD boot-video graphics mode ends here, so the
+	 * replayed loader text and the prompt are on screen.
+	 */
+	efi_boot_video_text();
+#endif
+
 	/*
 	 * Not autobooting, go manual
 	 */
diff --git a/stand/efi/libefi/efi_console.c b/stand/efi/libefi/efi_console.c
index 46a3c95..53fe2b9 100644
--- a/stand/efi/libefi/efi_console.c
+++ b/stand/efi/libefi/efi_console.c
@@ -45,6 +45,25 @@ static EFI_SIMPLE_TEXT_INPUT_EX_PROTOCOL *coninex;
 static bool efi_started;
 static int mode;		/* Does ConOut have serial console? */
 
+/*
+ * NextBSD boot-video mode (the boot.efi role; xnu Boot_Video v_display).
+ * main() asks for GRAPHICS_MODE once, before the console is probed, and
+ * only when ConOut has no serial port and the boot flags ask for no text.
+ * In GRAPHICS_MODE no loader text reaches the screen: efi_cons_putchar()
+ * keeps every byte in a replay ring and teken never draws, so the screen
+ * belongs to the boot splash.  Every way out of a normal boot (the
+ * prompt, a loader panic, a failed boot) calls efi_boot_video_text(),
+ * which draws the text console and replays the ring, so a failure never
+ * leaves a silent screen.  comconsole output does not pass through this
+ * console and is never kept here.  FB_TEXT_MODE is the stock loader.
+ */
+static int boot_v_display = FB_TEXT_MODE;
+#define	BOOT_VIDEO_RING_SIZE	(16 * 1024)
+static char boot_video_ring[BOOT_VIDEO_RING_SIZE];
+static size_t boot_video_ring_head;
+static bool boot_video_ring_wrapped;
+static void boot_video_replay(void);
+
 static uint32_t utf8_left;
 static uint32_t utf8_partial;
 #ifdef TERM_EMU
@@ -527,6 +546,11 @@ efi_set_colors(struct env_var *ev, int flags, const void *value)
 		a.ta_bgcolor |= TC_LIGHT;
 
 	teken_set_defattr(&gfx_state.tg_teken, &a);
+	/* In boot-video GRAPHICS_MODE efi_boot_video_text() draws later. */
+	if (boot_v_display == GRAPHICS_MODE) {
+		env_setenv(ev->ev_name, flags | EV_NOHOOK, evalue, NULL, NULL);
+		return (CMD_OK);
+	}
 	cons_draw_frame(&a);
 	env_setenv(ev->ev_name, flags | EV_NOHOOK, evalue, NULL, NULL);
 	teken_input(&gfx_state.tg_teken, "\e[2J", 4);
@@ -911,6 +935,7 @@ cons_update_mode(bool use_gfx_mode)
 	teken_attr_t attr;
 	EFI_STATUS status;
 	char env[10], *ptr;
+	bool replay;
 
 	if (!efi_started)
 		return (false);
@@ -1045,6 +1070,18 @@ cons_update_mode(bool use_gfx_mode)
 		}
 	}
 
+	/*
+	 * Boot-video GRAPHICS_MODE needs the teken console on a GOP
+	 * framebuffer with no serial port in ConOut; anything else is text.
+	 */
+	replay = false;
+	if (boot_v_display == GRAPHICS_MODE &&
+	    (screen_buffer == NULL || gfx_state.tg_fb_type == FB_TEXT ||
+	    (mode & (RB_SERIAL | RB_MULTIPLE)) != 0)) {
+		boot_v_display = FB_TEXT_MODE;
+		replay = true;
+	}
+
 	if (screen_buffer == NULL) {
 		conout->EnableCursor(conout, TRUE);
 #ifdef TERM_EMU
@@ -1056,6 +1093,15 @@ cons_update_mode(bool use_gfx_mode)
 		fg_c = DEFAULT_FGCOLOR;
 		bg_c = DEFAULT_BGCOLOR;
 #endif
+	} else if (boot_v_display == GRAPHICS_MODE) {
+		/*
+		 * Keep the attributes, draw nothing: the screen belongs to
+		 * the boot splash.  efi_boot_video_text() draws the frame,
+		 * erases and replays when the loader drops to text.
+		 */
+		if (attr.ta_bgcolor == TC_WHITE)
+			attr.ta_bgcolor |= TC_LIGHT;
+		teken_set_defattr(&gfx_state.tg_teken, &attr);
 	} else {
 		/* Improve visibility */
 		if (attr.ta_bgcolor == TC_WHITE)
@@ -1078,6 +1124,9 @@ cons_update_mode(bool use_gfx_mode)
 	snprintf(env, sizeof (env), "%u", (unsigned)cols);
 	setenv("COLUMNS", env, 1);
 
+	if (replay)
+		boot_video_replay();
+
 	return (true);
 }
 
@@ -1196,6 +1245,16 @@ efi_cons_putchar(int c)
 {
 	unsigned char ch = c;
 
+	/* Boot-video GRAPHICS_MODE: keep the text for a replay. */
+	if (boot_v_display == GRAPHICS_MODE) {
+		boot_video_ring[boot_video_ring_head++] = ch;
+		if (boot_video_ring_head == BOOT_VIDEO_RING_SIZE) {
+			boot_video_ring_head = 0;
+			boot_video_ring_wrapped = true;
+		}
+		return;
+	}
+
 	/*
 	 * Don't use Teken when we're doing pure serial, or a multiple console
 	 * with video "primary" because that's also serial.
@@ -1208,6 +1267,86 @@ efi_cons_putchar(int c)
 	teken_input(&gfx_state.tg_teken, &ch, sizeof (ch));
 }
 
+/*
+ * Ask for boot-video GRAPHICS_MODE.  main() calls this once, before
+ * cons_probe(); cons_update_mode() falls back to text when there is no
+ * GOP framebuffer.
+ */
+void
+efi_boot_video_graphics(void)
+{
+	if (!efi_started)
+		boot_v_display = GRAPHICS_MODE;
+}
+
+int
+efi_boot_video_display(void)
+{
+	return (boot_v_display);
+}
+
+/* Write the kept loader text to the (now text) console, oldest first. */
+static void
+boot_video_replay(void)
+{
+	size_t i;
+
+	if (boot_video_ring_wrapped) {
+		for (i = boot_video_ring_head; i < BOOT_VIDEO_RING_SIZE; i++)
+			efi_cons_putchar(boot_video_ring[i]);
+	}
+	for (i = 0; i < boot_video_ring_head; i++)
+		efi_cons_putchar(boot_video_ring[i]);
+	boot_video_ring_head = 0;
+	boot_video_ring_wrapped = false;
+}
+
+/*
+ * Leave boot-video GRAPHICS_MODE for good: draw the text console the way
+ * cons_update_mode() does in text mode, then replay the kept loader text.
+ * A no-op in text mode, so the stock loader is unchanged.
+ */
+void
+efi_boot_video_text(void)
+{
+	teken_attr_t attr;
+
+	if (boot_v_display != GRAPHICS_MODE)
+		return;
+	boot_v_display = FB_TEXT_MODE;
+	if (screen_buffer != NULL &&
+	    (mode & (RB_SERIAL | RB_MULTIPLE)) == 0) {
+		attr = *teken_get_defattr(&gfx_state.tg_teken);
+		cons_draw_frame(&attr);
+		teken_input(&gfx_state.tg_teken, "\e[2J", 4);
+		gfx_state.tg_functions->tf_param(&gfx_state,
+		    TP_SHOWCURSOR, 1);
+	}
+	boot_video_replay();
+}
+
+COMMAND_SET(boot_video, "boot-video",
+    "boot-video mode: status, is-graphics, text", command_boot_video);
+
+static int
+command_boot_video(int argc, char *argv[])
+{
+	if (argc < 2 || strcmp(argv[1], "status") == 0) {
+		printf("boot-video: %s\n", boot_v_display == GRAPHICS_MODE ?
+		    "graphics" : "text");
+		return (CMD_OK);
+	}
+	if (strcmp(argv[1], "is-graphics") == 0)
+		return (boot_v_display == GRAPHICS_MODE ? CMD_OK : CMD_ERROR);
+	if (strcmp(argv[1], "text") == 0) {
+		efi_boot_video_text();
+		return (CMD_OK);
+	}
+	snprintf(command_errbuf, sizeof(command_errbuf),
+	    "usage: boot-video [status | is-graphics | text]");
+	return (CMD_ERROR);
+}
+
 static int
 keybuf_getchar(void)
 {
diff --git a/stand/efi/loader/main.c b/stand/efi/loader/main.c
index b585168..f11e7e8 100644
--- a/stand/efi/loader/main.c
+++ b/stand/efi/loader/main.c
@@ -679,6 +679,7 @@ interactive_interrupt(const char *msg)
 {
 	time_t now, then, last;
 
+	efi_boot_video_text();	/* a failure is never a silent screen */
 	last = 0;
 	now = then = getsecs();
 	printf("%s\n", msg);
@@ -701,6 +702,53 @@ interactive_interrupt(const char *msg)
 	return (false);
 }
 
+/* Boot flags that keep the loader in boot-video text mode. */
+#define	BOOT_VIDEO_TEXT_HOWTO	\
+    (RB_VERBOSE | RB_SINGLE | RB_ASKNAME | RB_SERIAL | RB_MULTIPLE)
+
+/*
+ * The text-mode boot flags in the "-xyz" arguments (boot_parse_arg()'s
+ * letters), read without parse_args()'s side effects on the environment,
+ * which happen once the console exists.
+ */
+static int
+boot_video_args(int argc, CHAR16 *argv[])
+{
+	int i, howto;
+	char var[128], *v;
+
+	howto = 0;
+	for (i = 0; i < argc; i++) {
+		cpy16to8(argv[i], var, sizeof(var));
+		if (var[0] != '-')
+			continue;
+		for (v = var + 1; *v != '\0' && *v != 'S'; v++) {
+			switch (*v) {
+			case 'a': howto |= RB_ASKNAME; break;
+			case 'D': howto |= RB_MULTIPLE; break;
+			case 'h': howto |= RB_SERIAL; break;
+			case 's': howto |= RB_SINGLE; break;
+			case 'v': howto |= RB_VERBOSE; break;
+			}
+		}
+	}
+	return (howto);
+}
+
+/*
+ * A loader panic shows its text: leave boot-video graphics mode first.
+ * The rest is libsa's default panic_action().
+ */
+void
+panic_action(void)
+{
+	efi_boot_video_text();
+	printf("--> Press a key on the console to reboot <--\n");
+	getchar();
+	printf("Rebooting...\n");
+	exit(1);
+}
+
 static int
 parse_args(int argc, CHAR16 *argv[])
 {
@@ -1243,6 +1291,16 @@ main(int argc, CHAR16 *argv[])
 	if ((uhowto & RB_SERIAL) != 0)
 		setenv("console", "comconsole", 1);
 #endif
+	/*
+	 * NextBSD boot-video mode, decided once, here, before the console
+	 * exists (the boot.efi role).  Graphics only when ConOut has no
+	 * serial port and the boot flags ask for no text; cons_update_mode()
+	 * adds "and there is a GOP framebuffer".  Everything else, CI's
+	 * serial console included, is the stock text loader.
+	 */
+	if ((uhowto & (RB_SERIAL | RB_MULTIPLE)) == 0 &&
+	    (boot_video_args(argc, argv) & BOOT_VIDEO_TEXT_HOWTO) == 0)
+		efi_boot_video_graphics();
 	cons_probe();
 
 	/* Set print_delay variable to have hooks in place. */
@@ -1347,6 +1405,10 @@ main(int argc, CHAR16 *argv[])
 	 */
 	boot_howto_to_env(howto);
 
+	/* Verbose, single-user, askname or a serial console mean text. */
+	if ((howto & BOOT_VIDEO_TEXT_HOWTO) != 0)
+		efi_boot_video_text();
+
 	if (efi_copy_init())
 		return (EFI_BUFFER_TOO_SMALL);
 
diff --git a/stand/lua/loader.lua b/stand/lua/loader.lua
index 0874239..ec08a98 100644
--- a/stand/lua/loader.lua
+++ b/stand/lua/loader.lua
@@ -39,6 +39,32 @@ local password = require("password")
 
 config.load()
 
+-- NextBSD boot-video mode.  loader.efi starts in graphics mode only on a
+-- GOP console with no serial port in ConOut and no -v/-s; loader.conf can
+-- still ask for text.  Leaving graphics mode replays the kept loader text.
+-- Done before efi-autoresizecons, which redraws a text console as today.
+local function bootVideoWantsText()
+	local function isSet(name)
+		local v = loader.getenv(name)
+		return v ~= nil and v:lower() ~= "no"
+	end
+	local console = loader.getenv("console") or ""
+	local eli = loader.getenv("geom_eli_passphrase_prompt") or ""
+	return isSet("boot_verbose") or isSet("boot_single") or
+	    isSet("boot_askname") or isSet("boot_serial") or
+	    isSet("boot_multicons") or console:find("comconsole") ~= nil or
+	    -- anything that waits for the user needs the text console
+	    not core.isMenuSkipped() or eli:lower() == "yes" or
+	    loader.getenv("bootlock_password") ~= nil or
+	    loader.getenv("password") ~= nil
+end
+
+if core.isUEFIBoot() and loader.has_command("boot-video") and
+    loader.perform("boot-video is-graphics") == 0 and
+    bootVideoWantsText() then
+	loader.perform("boot-video text")
+end
+
 if core.isUEFIBoot() then
 	loader.perform("efi-autoresizecons")
 end
