From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: pkgdemon <jpm820@gmail.com>
Date: Sun, 1 Nov 2026 20:57:22 -0600
Subject: [PATCH] NextBSD: virtual_oss: build and install the Bluetooth backend
 voss_bt.so

lib/virtual_oss builds only the null and oss backends, so voss_bt.so,
virtual_oss's A2DP backend, was missing from the base. virtual_oss
exits when asked for a /dev/bluetooth/<addr> device, and
virtual_bt_speaker exits at startup because it dlsyms its AVDTP
acceptor from the same file (nextbsd/nextbsd#485). NextBSD takes
nothing from pkg.FreeBSD.org, so audio/virtual_oss_bluetooth is not
an option.

- lib/virtual_oss builds bt when MK_BLUETOOTH is on. It installs as
  /usr/lib/virtual_oss/voss_bt.so, next to voss_null.so and
  voss_oss.so. SBC only: HAVE_LIBAV is not defined, so there is no
  AAC and no ffmpeg dependency.
- Makefile.inc1 adds lib/libbluetooth and lib/libsdp, which voss_bt.so
  links, to _prebuild_libs. buildworld builds all of lib/ before it
  installs any of it, so without this they are not in the sysroot when
  voss_bt.so links.
- virtual_oss loads the bt backend from /usr instead of /usr/local.
  virtual_bt_speaker already uses /usr/lib/virtual_oss.

Carried out-of-tree for NextBSD.
---
 Makefile.inc1                           | 6 ++++++
 lib/virtual_oss/Makefile                | 1 +
 usr.sbin/virtual_oss/virtual_oss/main.c | 4 ++--
 3 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/Makefile.inc1 b/Makefile.inc1
index 2c79a8c..262cd7d 100644
--- a/Makefile.inc1
+++ b/Makefile.inc1
@@ -3401,6 +3401,12 @@ gnu/lib/libdialog__L: lib/msun__L lib/ncurses/tinfo__L lib/ncurses/ncurses__L
 _prebuild_libs+= lib/libregex
 .endif
 
+# lib/virtual_oss/bt (voss_bt.so) links libbluetooth and libsdp, and all of
+# lib/ is built before any of it is installed.
+.if ${MK_BLUETOOTH} != "no"
+_prebuild_libs+= lib/libbluetooth lib/libsdp
+.endif
+
 lib/libgeom__L: lib/libexpat__L lib/libsbuf__L
 lib/libkldelf__L: lib/libelf__L
 lib/libkvm__L: lib/libelf__L
diff --git a/lib/virtual_oss/Makefile b/lib/virtual_oss/Makefile
index e6cb5fb..c41ab41 100644
--- a/lib/virtual_oss/Makefile
+++ b/lib/virtual_oss/Makefile
@@ -2,6 +2,7 @@
 
 SUBDIR+= null \
 	 oss
+SUBDIR.${MK_BLUETOOTH}+= bt
 
 SUBDIR_PARALLEL=
 
diff --git a/usr.sbin/virtual_oss/virtual_oss/main.c b/usr.sbin/virtual_oss/virtual_oss/main.c
index 7e677b6..0ea2bc0 100644
--- a/usr.sbin/virtual_oss/virtual_oss/main.c
+++ b/usr.sbin/virtual_oss/virtual_oss/main.c
@@ -1669,7 +1669,7 @@ voss_rx_backend_refresh(void)
 	if (strcmp(voss_dsp_rx_device, "/dev/null") == 0) {
 		voss_rx_backend = voss_load_backend("/usr", "null", "rec");
 	} else if (strstr(voss_dsp_rx_device, "/dev/bluetooth/") == voss_dsp_rx_device) {
-		voss_rx_backend = voss_load_backend("/usr/local", "bt", "rec");
+		voss_rx_backend = voss_load_backend("/usr", "bt", "rec");
 	} else if (strstr(voss_dsp_rx_device, "/dev/sndio/") == voss_dsp_rx_device) {
 		voss_rx_backend = voss_load_backend("/usr/local", "sndio", "rec");
 	} else {
@@ -1684,7 +1684,7 @@ voss_tx_backend_refresh(void)
 	if (strcmp(voss_dsp_tx_device, "/dev/null") == 0) {
 		voss_tx_backend = voss_load_backend("/usr", "null", "play");
 	} else if (strstr(voss_dsp_tx_device, "/dev/bluetooth/") == voss_dsp_tx_device) {
-		voss_tx_backend = voss_load_backend("/usr/local", "bt", "play");
+		voss_tx_backend = voss_load_backend("/usr", "bt", "play");
 	} else if (strstr(voss_dsp_tx_device, "/dev/sndio/") == voss_dsp_tx_device) {
 		voss_tx_backend = voss_load_backend("/usr/local", "sndio", "play");
 	} else {
