@@ -136,6 +136,20 @@ marked as
 .Dq dump
 or
 .Dq swap .
+On NextBSD a
+.Ar device
+may also be the absolute path of a dump file, a regular file that
+.Xr dumpon 8
+configured as the dump target; it is read in 4096-byte sectors.
+A dump file cannot be written while
+.Xr dumpon 8
+has it configured, so run
+.Nm
+before
+.Xr dumpon 8 ,
+or after
+.Dq Nm dumpon Fl r ,
+to let it clear the dump header.
 The
 .Nm
 utility
diff --git a/sbin/savecore/savecore.c b/sbin/savecore/savecore.c
index 2f3ad3ad..27f5ac5b 100644
--- a/sbin/savecore/savecore.c
+++ b/sbin/savecore/savecore.c
@@ -97,6 +97,13 @@
 /* The size of the buffer used for I/O. */
 #define	BUFFERSIZE	(1024*1024)
 
+/*
+ * NextBSD: the sector size of a regular dump file.  The kernel's file
+ * dumper writes it in blocks of this size, with the trailing header in
+ * the last whole block.
+ */
+#define	DUMPFILE_SECTORSIZE	4096
+
 #define	STATUS_BAD	0
 #define	STATUS_GOOD	1
 #define	STATUS_UNKNOWN	2
@@ -931,6 +938,7 @@ DoFile(const char *savedir, int savedirfd, const char *device)
 	struct kerneldumpheader kdhf, kdhl;
 	uint8_t *dumpkey;
 	off_t mediasize, dumpextent, dumplength, firsthd, lasthd;
+	struct stat sb;
 	FILE *core;
 	int fdcore, fddev, error;
 	int bounds, status;
@@ -972,9 +980,24 @@ DoFile(const char *savedir, int savedirfd, const char *device)
 		return;
 	}
 
-	error = ioctl(fddev, DIOCGMEDIASIZE, &mediasize);
-	if (!error)
-		error = ioctl(fddev, DIOCGSECTORSIZE, &sectorsize);
+	if (fstat(fddev, &sb) == 0 && S_ISREG(sb.st_mode)) {
+		/*
+		 * A dump file (dumpon(8) on a regular file): the kernel
+		 * used its whole 4096-byte blocks as the dump medium.
+		 */
+		sectorsize = DUMPFILE_SECTORSIZE;
+		mediasize = rounddown(sb.st_size, DUMPFILE_SECTORSIZE);
+		if (mediasize < 2 * DUMPFILE_SECTORSIZE) {
+			logmsg(LOG_ERR, "%s is too small to hold a dump",
+			    device);
+			goto closefd;
+		}
+		error = 0;
+	} else {
+		error = ioctl(fddev, DIOCGMEDIASIZE, &mediasize);
+		if (!error)
+			error = ioctl(fddev, DIOCGSECTORSIZE, &sectorsize);
+	}
 	if (error) {
 		logmsg(LOG_ERR,
 		    "couldn't find media and/or sector size of %s: %m", device);
@@ -1274,9 +1297,15 @@ DoFile(const char *savedir, int savedirfd, const char *device)
 		memcpy(kdhl.magic, KERNELDUMPMAGIC_CLEARED, sizeof(kdhl.magic));
 		memcpy(temp, &kdhl, sizeof(kdhl));
 		if (lseek(fddev, lasthd, SEEK_SET) != lasthd ||
-		    write(fddev, temp, sectorsize) != (ssize_t)sectorsize)
-			logmsg(LOG_ERR,
-			    "error while clearing the dump header: %m");
+		    write(fddev, temp, sectorsize) != (ssize_t)sectorsize) {
+			if (errno == ETXTBSY)
+				logmsg(LOG_ERR, "cannot clear the dump header: "
+				    "%s is in use by dumpon(8); run savecore "
+				    "before dumpon, or after dumpon -r", device);
+			else
+				logmsg(LOG_ERR,
+				    "error while clearing the dump header: %m");
+		}
 	}
 	xo_close_container_h(xostdout, "crashdump");
 	if (xo_finish_h(xostdout) < 0)
@@ -1295,7 +1324,10 @@ DoFile(const char *savedir, int savedirfd, const char *device)
 	close(fddev);
 }
 
-/* Prepend "/dev/" to any arguments that don't already have it */
