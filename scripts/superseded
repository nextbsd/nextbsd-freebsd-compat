# Superseded base tools (enforced by strip-superseded.sh).
#
# FreeBSD base tools NextBSD replaces with its own implementation. NOT path
# collisions with the overlay — just dead/conflicting weight, so the base drops
# them. Each path is existence-asserted at build time: a stale entry (base no
# longer ships it) fails the build so this list stays honest.
#
# Verified 2026-07-03: all present on stock FreeBSD 15.0-p9, and absent+unused on
# the running NextBSD box (launchd is PID 1; kextd/IOKit drive module load +
# device attach; no kld/devd refs in loader.conf/rc.conf).

/sbin/init                # launchd is PID 1
/sbin/kldload             # kextload + kextd
/sbin/kldstat             # kextstat
/sbin/kldunload           # kextunload
/sbin/kldconfig           # kextd search-path config
/sbin/devd                # IOKit device attach via kextd
/sbin/devmatch            # IOKit device matching
/usr/sbin/bsdconfig       # nextbsd-installer
/usr/sbin/bsdinstall      # nextbsd-installer
/usr/sbin/freebsd-update  # base rolls via pkg (NextBSD-* packages)

# The BSD LPD print system: CUPS replaces it, as on macOS, which ships no lpd
# (Apple's CUPS 2.3.4 in nextbsd-printing-support, E24 D5,
# nextbsd/nextbsd-printing-support#1). CUPS installs its own lp, lpr, lpq, lprm
# and lpc at these paths, so the base copies would collide in the image and in
# pkg; the rest of the suite (lpd, its accounting, checking and filter tools,
# printcap(5), hosts.lpd(5)) only works with lpd. lpr, lpq and lprm are setuid
# root in the base, one more reason not to keep an unused copy. lp(4), the
# parallel-port driver page, is not part of this and stays.
/usr/bin/lp                         # CUPS lp(1)
/usr/bin/lpr                        # CUPS lpr(1)
/usr/bin/lpq                        # CUPS lpq(1)
/usr/bin/lprm                       # CUPS lprm(1)
/usr/sbin/lpc                       # CUPS lpc(8)
/usr/sbin/lpd                       # cupsd (org.nextbsd.cupsd); cups-lpd serves LPD clients
/usr/sbin/chkprintcap               # lpd's printcap checker
/usr/sbin/pac                       # lpd's accounting
/usr/sbin/lptest                    # lpd's test-pattern generator
/usr/libexec/lpr                    # lpd's filters (lpf, ru/)
/usr/share/man/man1/lp.1.gz         # CUPS ships lp.1
/usr/share/man/man1/lpr.1.gz        # CUPS ships lpr.1
/usr/share/man/man1/lpq.1.gz        # CUPS ships lpq.1
/usr/share/man/man1/lprm.1.gz       # CUPS ships lprm.1
/usr/share/man/man1/lptest.1.gz
/usr/share/man/man8/lpc.8.gz        # CUPS ships lpc.8
/usr/share/man/man8/lpd.8.gz
/usr/share/man/man8/pac.8.gz
/usr/share/man/man8/chkprintcap.8.gz
/usr/share/man/man5/printcap.5.gz
/usr/share/man/man5/hosts.lpd.5.gz

# FreeBSD's pkg(7) bootstrap: NextBSD ships the real pkg(8) in base, built from
# freebsd/pkg 2.8.4 with NextBSD's patches in nextbsd-contrib
# (nextbsd/nextbsd-contrib#7; design: nextbsd-pkg wiki, "pkg comes only from
# the NextBSD repo"). It installs /usr/sbin/pkg at the shim's path. The shim
# exists only to fetch pkg from pkg.FreeBSD.org; its man page and the key it
# verifies that download with go with it. /usr/share/pkg/triggers/mandoc.ucl
# stays: it is mandoc's trigger, which the real pkg runs.
/usr/sbin/pkg                                         # pkg(8) from nextbsd-contrib
/usr/share/man/man7/pkg.7.gz                          # the bootstrap's page; pkg(8) has its own
/usr/share/keys/pkg/trusted/pkg.freebsd.org.2013102301  # the bootstrap's pkg.FreeBSD.org key

# BlocksRuntime SHADOW (library, not a tool; NOT an exact-path collision, so the
# collision guard misses it). FreeBSD ships libBlocksRuntime in /usr/lib; Apple
# ships the canonical one in /usr/lib/system. rtld searches /usr/lib BEFORE
# /usr/lib/system, so the base copy shadows Apple's and breaks ObjC at runtime:
# libobjc2's DT_NEEDED "libBlocksRuntime.so" binds to the base copy, which lacks
# _Block_use_RR2 (an Apple/libdispatch symbol). Symptom: gnustep-base configure
# "checking whether objc really works... no" (Undefined symbol _Block_use_RR2).
# Apple's /usr/lib/system copy wins — strip the base ones. (Audited 2026-07-04:
# BlocksRuntime is the ONLY such shadow across Apple's /usr/lib/system set.)
/usr/lib/libBlocksRuntime.so
/usr/lib/libBlocksRuntime.so.0
/usr/lib/libBlocksRuntime.a

# CANDIDATE — held out until confirmed the NextBSD kernel package ships or
# regenerates /boot/kernel/linker.hints (kldxref builds it). Re-enable then.
# /usr/sbin/kldxref
