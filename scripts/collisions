# Base<->userland collision allowlist (enforced by strip-collisions.sh).
#
# Every path here is shipped by BOTH the FreeBSD buildworld base AND the
# NextBSD-userland (Apple/Darwin) overlay. The overlay owns the canonical copy,
# so the base strips it. Any base<->userland overlap NOT listed here fails the
# build — add new ones deliberately (with a reason) or stop shipping them.
#
# Originally derived by intersecting a stock FreeBSD 15.0-p9 base against
# NextBSD-userland's 565-file plist (2026-07-03): the first 3 below. The syslog
# man pages were added 2026-07-05 after the base dropped WITHOUT_MAN=yes
# (nextbsd-freebsd-compat e58e0f2 "ship man pages") — the full-buildworld base
# now installs FreeBSD's syslog(3)/syslog.conf(5)/syslogd(8) pages, which the
# Apple ASL overlay also ships. syslogd is already overlay-owned (below), so its
# whole man-page family follows the daemon: the overlay owns them, base strips.
/usr/sbin/syslogd                     # Apple ASL syslogd (wired to com.apple.syslogd.plist)
/usr/include/Block.h                  # Apple Blocks header (matches libdispatch/CF ABI)
/usr/include/Block_private.h          # Apple private Blocks header
/usr/share/man/man1/syslog.1.gz       # Apple syslog(1) CLI (no base equivalent; overlay-owned)
/usr/share/man/man3/syslog.3.gz       # Apple ASL syslog(3) — libsystem_asl owns the API
/usr/share/man/man5/syslog.conf.5.gz  # Apple ASL syslog.conf(5)
/usr/share/man/man8/syslogd.8.gz      # Apple ASL syslogd(8) — matches /usr/sbin/syslogd above

# Account tools (E18 U9/U14, nextbsd/nextbsd-userland#291). The userland ships
# NextBSD's adduser, passwd, rmuser, chpass and pw at these paths. Each routes:
# a directory account is handled in the DirectoryServices property lists, and a
# system account in /etc/master.passwd by the FreeBSD pw and chpass, which the
# userland vendors into its own binaries rather than exec'ing from a second
# location. So the base copies here are simply replaced, not moved.
#
# These entries only take effect once the userland publishes each path, so this
# file can land alongside that change rather than ahead of it.
/usr/bin/passwd                       # NextBSD passwd(1), setuid; plists or master.passwd
/usr/bin/chpass                       # NextBSD chpass(1), setuid; FreeBSD's is vendored inside it
/usr/bin/chfn                         # link
/usr/bin/chsh                         # link
/usr/bin/ypchpass                     # link
/usr/bin/ypchfn                       # link
/usr/bin/ypchsh                       # link
/usr/sbin/adduser                     # NextBSD adduser(8), over the plists
/usr/sbin/rmuser                      # NextBSD rmuser(8), over the plists
/usr/sbin/pw                          # NextBSD pw(8); FreeBSD's is vendored inside it
/usr/share/man/man1/passwd.1.gz       # NextBSD passwd(1)
/usr/share/man/man1/chpass.1.gz       # NextBSD chpass(1)
/usr/share/man/man1/chfn.1.gz         # link
/usr/share/man/man1/chsh.1.gz         # link
/usr/share/man/man1/ypchpass.1.gz     # link
/usr/share/man/man1/ypchfn.1.gz       # link
/usr/share/man/man1/ypchsh.1.gz       # link
/usr/share/man/man8/pw.8.gz           # NextBSD pw(8)
/usr/share/man/man8/adduser.8.gz      # NextBSD adduser(8)
/usr/share/man/man8/rmuser.8.gz       # NextBSD rmuser(8)

# tzsetup (E18 U18, nextbsd/nextbsd-userland#302). The userland ships NextBSD's
# own at the same path, in the installer's look, and with a checkbox that turns
# on org.nextbsd.ntpd -- which the base one knows nothing about, since it
# predates launchd here.
#
# Only the binary and its page are replaced. The zone data underneath is
# FreeBSD's and stays: /usr/share/zoneinfo, including zone1970.tab and
# iso3166.tab, which the new one reads exactly as the old one did.
/usr/sbin/tzsetup                     # NextBSD tzsetup(8), in the installer's look
/usr/share/man/man8/tzsetup.8.gz      # NextBSD tzsetup(8)
